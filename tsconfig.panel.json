{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": false,
    // 浏览器里 "/graph-scene.js" 由面板的 ASSETS 喂；tsc 不认识那条路，
    // 在这里把它指回真文件 —— 检查的就是运行时真正加载的那份。
    "paths": {
      "/graph-scene.js": ["./src/web/graph-scene.js"]
    }
  },
  "include": [
    "src/web/panel.js",
    "src/web/codex-stream.js",
    "src/web/graph-view.js",
    "src/web/graph-scene.js",
    "src/web/panel-globals.d.ts"
  ]
}
