{
  "name": "stagepass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-supervisor.ts",
    "predev:next": "pnpm db:migrate",
    "dev:next": "next dev",
    "preworker:pipeline": "pnpm db:migrate",
    "worker:pipeline": "tsx scripts/pipeline-worker.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "build": "next build",
    "prestart": "pnpm db:migrate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/run-tests-isolated.ts",
    "test:acceptance": "tsx scripts/run-tests-isolated.ts --acceptance",
    "test:all": "tsx scripts/run-tests-isolated.ts --all",
    "test:phase0-verifier": "tsx --test --test-concurrency=1 server/services/codex-phase0-verifier-contract.test.ts server/services/codex-phase0-restart-resume.test.ts",
    "typecheck:phase0-verifier": "tsc --project tsconfig.phase0-verifier.json",
    "mcp:build": "tsx scripts/build-mcp-app.ts",
    "mcp:start": "tsx mcp/supervisor.ts",
    "premcp:start": "pnpm mcp:build",
    "build:codex-desktop-mcp-spike": "tsx scripts/build-codex-desktop-mcp-spike.ts",
    "preverify:codex-desktop-bridge": "pnpm build:codex-desktop-mcp-spike",
    "verify:codex-desktop-bridge": "tsx scripts/verify-codex-desktop-bridge.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@next/env": "16.2.9",
