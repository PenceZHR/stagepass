{
  "name": "stagepass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.src.json",
    "check": "pnpm typecheck && pnpm test",
    "verify:rebuild": "tsx scripts/verify-rebuild.ts",
    "verify:decision": "tsx scripts/verify-decision.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
