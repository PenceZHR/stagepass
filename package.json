{
  "name": "stagepass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.panel.json",
    "check": "pnpm typecheck && pnpm test",
    "panel": "tsx scripts/panel.ts",
    "schema:app-server": "codex app-server generate-json-schema --experimental --out docs/app-server-schema"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
